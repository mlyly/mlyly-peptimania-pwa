# ---------------------------------------------------------------------------
# Embedded notification relay (all optional)
#
# Without VAPID keys the app still builds and runs; reminders work on-device
# while the app is open, and `/v1/config` reports `configured: false`.
# Generate a key pair with: npm run vapid:generate
# ---------------------------------------------------------------------------

# Public key served to browsers via GET /v1/config.
VAPID_PUBLIC_KEY=
# Private key — server only. Never expose as NEXT_PUBLIC_*.
VAPID_PRIVATE_KEY=
# Contact address required by the Web Push spec (mailto: or https:).
VAPID_SUBJECT=mailto:you@example.com

# SQLite file. Docker/Dokploy: point this at the persistent volume.
# Local default: .data/notifications.sqlite
NOTIFICATIONS_DB_PATH=/data/notifications.sqlite

# Comma-separated extra browser origins allowed to call the relay. The app's
# own origin is always allowed. Only needed for a separately hosted PWA.
NOTIFICATIONS_ALLOWED_ORIGINS=

# In-process minute scheduler. Set to 0 when an external cron hits the DB.
NOTIFICATIONS_SCHEDULER=1
NOTIFICATIONS_SCHEDULER_INTERVAL_MS=60000

# Relay limits (defaults shown).
NOTIFICATIONS_MAX_REMINDERS=1000
NOTIFICATIONS_HORIZON_DAYS=30
NOTIFICATIONS_SUBSCRIPTION_RETENTION_DAYS=90
NOTIFICATIONS_SENT_RETENTION_DAYS=7

# Optional: point the client at a separately hosted relay. Leave empty to use
# the same origin (the default, embedded deployment).
# NEXT_PUBLIC_NOTIFICATION_RELAY_URL=https://notifications.example.com
